<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮球：iOS 质感的玻璃珠。
  自上而下的受光渐变做出球体，左上角一小块高光当镜面反射，
  外圈那一道偏亮的描边是玻璃的折射边。整体比深色版本更亮、更干净。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 落在桌面上的柔和投影 -->
    <item android:top="1.5dp">
        <shape android:shape="oval">
            <solid android:color="#24000000" />
        </shape>
    </item>

    <!-- 珠体 -->
    <item android:bottom="1.5dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="72%p"
                android:centerX="0.36"
                android:centerY="0.30"
                android:startColor="#FF6FE3C6"
                android:centerColor="#FF2BC4A0"
                android:endColor="#FF0C6B58" />
        </shape>
    </item>

    <!-- 上半部的镜面受光 -->
    <item android:bottom="1.5dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#59FFFFFF"
                android:centerColor="#0FFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- 折射边 -->
    <item android:bottom="1.5dp">
        <shape android:shape="oval">
            <stroke android:width="0.75dp" android:color="#8CFFFFFF" />
        </shape>
    </item>
</layer-list>
