<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮球：白色透明的玻璃珠，判定结果染在上面。

  珠体本身是白的，平时就是一颗白玻璃珠；判定给出结果时把颜色刷进 ball_tint 那一层，
  绿色表示可以放心回，黄色表示要留神，红色表示这条很危险。染色层平时是全透明的，
  所以没判定过的时候它就是白的。

  受光渐变和高光都留白，不做成彩色渐变——一旦珠体本身带饱和度，就不再是玻璃，
  而是一颗彩球了。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 落在桌面上的柔和投影 -->
    <item android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#40000000" />
        </shape>
    </item>

    <!-- 珠体：白色玻璃。靠不透明度的渐变做出球体的厚度 -->
    <item android:bottom="1.5dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="72%p"
                android:centerX="0.36"
                android:centerY="0.30"
                android:startColor="#FFFFFFFF"
                android:centerColor="#E6FFFFFF"
                android:endColor="#B3FFFFFF" />
        </shape>
    </item>

    <!-- 判定结果的染色层。代码用 findDrawableByLayerId 拿到它改颜色，
         用 setLayerAlpha 控制浓度，所以它能淡入淡出。 -->
    <item android:id="@+id/ball_tint" android:bottom="1.5dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- 上半部的镜面受光 -->
    <item android:bottom="1.5dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#66FFFFFF"
                android:centerColor="#1AFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- 轮廓。这一版是深色的：白色玻璃球落在浅色聊天背景（#f2f2f7）上没有
         深色边就完全立不住，实测只剩一个 J 字浮在那儿。原来的白色亮边在浅背景
         上等于没画。 -->
    <item android:bottom="1.5dp">
        <shape android:shape="oval">
            <stroke android:width="0.9dp" android:color="#33000000" />
        </shape>
    </item>
</layer-list>
