<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingLeft="13dp"
    android:paddingRight="13dp"
    android:paddingTop="11dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:id="@+id/card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/card_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="建议：—"
            android:textColor="#FF2BC4A0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_drag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="2dp"
            android:text="⠿"
            android:textColor="#FF5F6A72"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:lineSpacingExtra="2dp"
        android:text=""
        android:textColor="#FFE6E9EC"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/card_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#FF8A939B"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/card_again"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#222BC4A0"
            android:text="重判"
            android:textAllCaps="false"
            android:textColor="#FF2BC4A0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/card_copy"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="#22FFFFFF"
            android:text="复制"
            android:textAllCaps="false"
            android:textColor="#FFE6E9EC"
            android:textSize="12sp" />

        <Button
            android:id="@+id/card_close"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="#22FFFFFF"
            android:text="收起"
            android:textAllCaps="false"
            android:textColor="#FFE6E9EC"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
